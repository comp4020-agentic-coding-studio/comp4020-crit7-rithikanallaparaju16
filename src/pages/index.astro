---
import Layout from "../layouts/Layout.astro";
import { COURSES, findCourse, MAX_COURSES } from "../lib/catalogue";
import { listStudents } from "../lib/db";

const students = listStudents();
const error = Astro.url.searchParams.get("error");
---

<Layout title="Students">
  <h1>Class registration</h1>
  <p>
    Pick a student to see their week. Lectures are placed automatically; for each
    lab or tutorial, every available time is laid over the timetable so you can
    choose around what's already there.
  </p>

  <section aria-labelledby="students-heading">
    <h2 id="students-heading">Students</h2>
    <ul class="student-list">
      {
        students.map((s) => (
          <li>
            <a href={`/students/${s.id}`}>{s.name}</a>
            <ul class="enrolled">
              {s.courseCodes.map((code) => (
                <li>
                  <strong>{code}</strong> <span class="muted">{findCourse(code)?.name}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="new-heading">
    <h2 id="new-heading">Add a student</h2>
    {error && <p class="error" role="alert">Enter a name and choose 1 to {MAX_COURSES} courses.</p>}
    <form method="post" action="/api/students" class="new-student">
      <label for="name">Name</label>
      <input id="name" name="name" required maxlength="80" autocomplete="off" />
      <fieldset>
        <legend>Courses (up to {MAX_COURSES})</legend>
        {
          COURSES.map((c) => (
            <label class="check">
              <input type="checkbox" name="courses" value={c.code} />
              <span>
                <strong>{c.code}</strong> {c.name}
              </span>
            </label>
          ))
        }
      </fieldset>
      <button>Create timetable</button>
    </form>
  </section>
</Layout>
