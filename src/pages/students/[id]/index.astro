---
import Layout from "../../../layouts/Layout.astro";
import { type Activity, DAYS, describeSlot, findCourse, formatTime } from "../../../lib/catalogue";
import { getTimetable, seatsTaken } from "../../../lib/db";
import { placeDay } from "../../../lib/layout";

const data = getTimetable(Number(Astro.params.id));
if (!data) {
  return new Response("No such student", { status: 404 });
}
const { student, courseCodes, labs } = data;
const courses = courseCodes.map((code) => findCourse(code)!).filter(Boolean);
const colour = new Map(courses.map((c, i) => [c.code, `c${i}`]));
const seats = seatsTaken();

// Without JavaScript, ?pick= opens one course's options; the script below
// takes over from this starting state and opens/closes courses in place.
const picked = Astro.url.searchParams.get("pick");
const open = courses.filter((c) => c.code === picked).map((c) => c.code);

type Block =
  | { type: "lecture"; activity: Activity }
  | {
      type: "group";
      activity: Activity;
      chosen: boolean;
      visible: boolean;
      isOption: boolean;
      full: boolean;
    };

const blocks: Block[] = courses.flatMap((c) => [
  ...c.lectures.map((activity): Block => ({ type: "lecture", activity })),
  ...c.groups.map((activity): Block => {
    const chosen = labs.get(c.code) === activity.id;
    const isOption = open.includes(c.code);
    const full = !chosen && seats[activity.id] >= activity.capacity;
    return { type: "group", activity, chosen, isOption, visible: isOption || chosen, full };
  }),
]);

const DAY_START = 8 * 60;
const DAY_END = 18 * 60;
const hours = Array.from({ length: (DAY_END - DAY_START) / 60 }, (_, i) => DAY_START + i * 60);
const days = DAYS.map((name, day) => {
  const mine = blocks.filter((b) => b.activity.day === day);
  const visible = mine.filter((b) => b.type === "lecture" || b.visible);
  const lanes = new Map(placeDay(visible).map((p) => [p.item, p]));
  return { name, blocks: mine.map((b) => ({ block: b, place: lanes.get(b) })) };
});

const styleFor = (a: Activity, place?: { lane: number; lanes: number }) =>
  [
    `--start: ${(a.start - DAY_START) / 60}`,
    `--length: ${(a.end - a.start) / 60}`,
    `--lane: ${place?.lane ?? 0}`,
    `--lanes: ${place?.lanes ?? 1}`,
  ].join("; ");
const timeOf = (a: Activity) => `${formatTime(a.start)}–${formatTime(a.end)}`;
const seatText = (taken: number, capacity: number, full: boolean) =>
  full ? `Full · ${taken}/${capacity}` : `${taken}/${capacity} seats`;
const unchosen = courses.filter((c) => !labs.has(c.code)).length;
const progressText = (n: number) =>
  n === 0 ? "every class registered" : `${n} still to choose`;
const defaultHint = "Lectures are already on your week. Choose a lab or tutorial to see every time it runs.";

const feed = new URL(`/api/students/${student.id}/calendar.ics`, Astro.url);
const webcal = feed.href.replace(/^https?:/, "webcal:");
const googleCalendar = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcal)}`;
// Google fetches the feed from its own servers, so it can't reach a local dev server.
const localOnly = /^(localhost|127\.|10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.)/.test(feed.hostname);
---

<Layout title={student.name} wide>
  <h1>{student.name}</h1>
  <p class="muted">
    {courses.length} courses · <span id="progress">{progressText(unchosen)}</span> ·{" "}
    <a href={`/students/${student.id}/edit`}>Edit courses</a> ·{" "}
    <a href="#calendar">Add to calendar</a>
  </p>

  <div
    class="planner"
    data-student={student.id}
    data-labs={JSON.stringify([...labs])}
    data-open={JSON.stringify(open)}
    data-default-hint={defaultHint}
  >
    <section aria-labelledby="courses-heading" class="courses">
      <h2 id="courses-heading">Courses</h2>
      <ul>
        {
          courses.map((c) => {
            const lab = c.groups.find((g) => g.id === labs.get(c.code));
            const isOpen = open.includes(c.code);
            const kind = c.groupKind.toLowerCase();
            return (
              <li
                class:list={["course", colour.get(c.code), { active: isOpen }]}
                data-course={c.code}
                data-kind={kind}
              >
                <h3>
                  {c.code} <span class="course-name">{c.name}</span>
                </h3>
                <p>
                  <span class="tag">Lectures</span> added automatically
                </p>
                <p>
                  <span class="tag">{c.groupKind}</span>{" "}
                  <span class="lab-status">{lab ? describeSlot(lab) : <em>not chosen yet</em>}</span>
                  <span class="seat-status">{lab ? ` · ${seats[lab.id]}/${lab.capacity} seats` : ""}</span>
                </p>
                <a
                  class:list={["button toggle", { secondary: isOpen }]}
                  href={isOpen ? `/students/${student.id}#timetable` : `/students/${student.id}?pick=${c.code}#timetable`}
                >
                  {isOpen ? "Hide options" : lab ? `Change ${kind}` : `Choose ${kind}`}
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section aria-labelledby="week-heading" class="week" id="timetable">
      <h2 id="week-heading">Week</h2>
      <p class="hint" id="hint" role="status">
        {
          open.length
            ? `Showing every ${open.join(", ")} time. Dashed blocks are options — click one to choose it.`
            : defaultHint
        }
      </p>
      <div class="day-tabs" role="group" aria-label="Day to show" hidden>
        {
          DAYS.map((name, i) => (
            <button type="button" data-day={i} aria-pressed="false">
              {name.slice(0, 3)} <span class="count"></span>
            </button>
          ))
        }
      </div>
      <div class="grid-scroll">
        <div class="grid" style={`--hours: ${hours.length}`}>
          <div class="hours" aria-hidden="true">
            {hours.map((h) => <span>{formatTime(h)}</span>)}
          </div>
          {
            days.map((day, i) => (
              <section class="day" aria-label={day.name} data-day={i}>
                <h3 class="day-name">{day.name.slice(0, 3)}</h3>
                <ol class="day-body">
                  {day.blocks.map(({ block, place }) => {
                    const a = block.activity;
                    const style = styleFor(a, place);
                    const name = findCourse(a.courseCode)?.name;
                    if (block.type === "lecture") {
                      return (
                        <li
                          class:list={["block lecture", colour.get(a.courseCode), { dimmed: open.length > 0 }]}
                          style={style}
                          data-start={a.start}
                          data-end={a.end}
                        >
                          <span>
                            <strong>{a.courseCode}</strong> {name}
                          </span>
                          <span>Lecture · {timeOf(a)}</span>
                          <span class="small">{a.room}</span>
                        </li>
                      );
                    }
                    return (
                      <li
                        class:list={[
                          "block group",
                          colour.get(a.courseCode),
                          { option: block.isOption, current: block.chosen, full: block.full },
                        ]}
                        style={style}
                        hidden={!block.visible}
                        data-course={a.courseCode}
                        data-activity={a.id}
                        data-start={a.start}
                        data-end={a.end}
                        data-capacity={a.capacity}
                        data-taken={seats[a.id]}
                        data-label={`${a.courseCode} ${a.kind} · ${describeSlot(a)}`}
                        data-slot={describeSlot(a)}
                      >
                        <form method="post" action={`/api/students/${student.id}/labs`}>
                          <input type="hidden" name="course" value={a.courseCode} />
                          <input type="hidden" name="activity" value={a.id} />
                          <button aria-pressed={block.chosen ? "true" : "false"} disabled={block.isOption && block.full}>
                            <span class="sr-only">{a.courseCode} {a.kind.toLowerCase()}, {DAYS[a.day]}</span>
                            <span>
                              <span class="tick" aria-hidden="true">✓ </span>
                              <strong>{a.courseCode}</strong> {name}
                            </span>
                            <span>{a.kind} · {timeOf(a)}</span>
                            <span class="small seats">{seatText(seats[a.id], a.capacity, block.full)}</span>
                            <span class="small">{a.room}</span>
                          </button>
                        </form>
                      </li>
                    );
                  })}
                </ol>
              </section>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <section aria-labelledby="calendar-heading" class="calendar-export" id="calendar">
    <h2 id="calendar-heading">Add to your calendar</h2>
    <p>
      Your lectures and chosen classes, repeating every week of the semester. This is a live
      calendar: when you change a class here, your calendar deletes the old time and adds the new
      one the next time it syncs. If you've added it before, there's no need to add it again.
    </p>
    <div class="calendar-buttons">
      <a class="button" href={googleCalendar} target="_blank" rel="noopener">Add to Google Calendar</a>
      <a class="button" href={webcal}>Add to Apple Calendar</a>
    </div>
    <p class="small muted">
      Apple Calendar checks for changes as often as you choose when subscribing; Google Calendar
      checks every few hours and can't be made faster. Classes you haven't chosen yet appear once
      you choose them.
    </p>
    {
      localOnly && (
        <p class="small muted">
          Google Calendar needs the deployed site: it can't reach a copy running on this computer.
        </p>
      )
    }
  </section>

  <div class="toast" id="toast" role="status" hidden>
    <span id="toast-text"></span>
    <button type="button" id="toast-undo">Undo</button>
    <button type="button" id="toast-close" class="secondary" aria-label="Dismiss">✕</button>
  </div>
</Layout>

<script>
  import { placeDay } from "../../../lib/layout";

  const root = document.querySelector<HTMLElement>(".planner[data-student]");
  if (root) {
    const studentId = Number(root.dataset.student);
    const labs = new Map<string, string>(JSON.parse(root.dataset.labs ?? "[]"));
    const open = new Set<string>(JSON.parse(root.dataset.open ?? "[]"));
    const groupBlocks = [...root.querySelectorAll<HTMLElement>(".block.group")];
    const seats = new Map(groupBlocks.map((el) => [el.dataset.activity!, Number(el.dataset.taken)]));
    const cards = [...root.querySelectorAll<HTMLElement>(".course[data-course]")];
    const hint = root.querySelector<HTMLElement>("#hint")!;
    const progress = document.querySelector<HTMLElement>("#progress")!;
    const grid = root.querySelector<HTMLElement>(".grid")!;
    const tabs = root.querySelector<HTMLElement>(".day-tabs")!;
    const toast = document.querySelector<HTMLElement>("#toast")!;
    const toastText = document.querySelector<HTMLElement>("#toast-text")!;
    const undoButton = document.querySelector<HTMLButtonElement>("#toast-undo")!;
    const narrow = window.matchMedia("(max-width: 40rem)");
    const stacked = window.matchMedia("(max-width: 60rem)");
    const today = new Date().getDay() - 1;
    let shownDay = today >= 0 && today < 5 ? today : 0;
    let lastChange: { course: string; previous: string | null } | undefined;
    let toastTimer: ReturnType<typeof setTimeout> | undefined;

    const blockFor = (activity?: string) => groupBlocks.find((el) => el.dataset.activity === activity);

    const render = () => {
      for (const el of groupBlocks) {
        const course = el.dataset.course!;
        const chosen = labs.get(course) === el.dataset.activity;
        const isOpen = open.has(course);
        const taken = seats.get(el.dataset.activity!) ?? 0;
        const capacity = Number(el.dataset.capacity);
        const full = !chosen && taken >= capacity;
        el.hidden = !isOpen && !chosen;
        el.classList.toggle("option", isOpen);
        el.classList.toggle("current", chosen);
        el.classList.toggle("full", full);
        const button = el.querySelector("button")!;
        button.setAttribute("aria-pressed", String(chosen));
        button.disabled = isOpen && full;
        el.querySelector(".seats")!.textContent = full
          ? `Full · ${taken}/${capacity}`
          : `${taken}/${capacity} seats`;
      }
      for (const el of root.querySelectorAll<HTMLElement>(".block.lecture")) {
        el.classList.toggle("dimmed", open.size > 0);
      }
      const optionsPerDay = [0, 0, 0, 0, 0];
      for (const day of root.querySelectorAll<HTMLElement>(".day")) {
        const index = Number(day.dataset.day);
        day.classList.toggle("shown", index === shownDay);
        const visible = [...day.querySelectorAll<HTMLElement>(".block")]
          .filter((el) => !el.hidden)
          .map((el) => ({ el, activity: { start: Number(el.dataset.start), end: Number(el.dataset.end) } }));
        optionsPerDay[index] = visible.filter((v) => v.el.classList.contains("option")).length;
        for (const { item, lane, lanes } of placeDay(visible)) {
          item.el.style.setProperty("--lane", String(lane));
          item.el.style.setProperty("--lanes", String(lanes));
        }
      }
      for (const tab of tabs.querySelectorAll<HTMLElement>("button")) {
        const index = Number(tab.dataset.day);
        tab.setAttribute("aria-pressed", String(index === shownDay));
        tab.querySelector(".count")!.textContent = optionsPerDay[index] ? `(${optionsPerDay[index]})` : "";
      }
      for (const card of cards) {
        const course = card.dataset.course!;
        const kind = card.dataset.kind!;
        const isOpen = open.has(course);
        const chosen = blockFor(labs.get(course));
        card.classList.toggle("active", isOpen);
        const status = card.querySelector(".lab-status")!;
        if (chosen) status.textContent = chosen.dataset.slot ?? "";
        else status.innerHTML = "<em>not chosen yet</em>";
        card.querySelector(".seat-status")!.textContent = chosen
          ? ` · ${seats.get(chosen.dataset.activity!)}/${chosen.dataset.capacity} seats`
          : "";
        const toggle = card.querySelector<HTMLElement>(".toggle")!;
        toggle.classList.toggle("secondary", isOpen);
        toggle.textContent = isOpen ? "Hide options" : chosen ? `Change ${kind}` : `Choose ${kind}`;
      }
      const left = cards.filter((c) => !labs.has(c.dataset.course!)).length;
      progress.textContent = left === 0 ? "every class registered" : `${left} still to choose`;
      hint.textContent = open.size
        ? `Showing every ${[...open].join(", ")} time. Dashed blocks are options — click one to choose it. Greyed-out classes are full.`
        : (root.dataset.defaultHint ?? "");
      return optionsPerDay;
    };

    const showToast = (text: string, canUndo: boolean) => {
      toastText.textContent = text;
      undoButton.hidden = !canUndo;
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => (toast.hidden = true), 10_000);
    };

    const save = async (course: string, activity: string | null) => {
      const body = new FormData();
      body.set("course", course);
      body.set("activity", activity ?? "");
      const res = await fetch(`/api/students/${studentId}/labs`, {
        method: "POST",
        headers: { accept: "application/json" },
        body,
      }).catch(() => undefined);
      if (res?.ok) return { ok: true as const };
      const data = await res?.json().catch(() => undefined);
      return { ok: false as const, full: data?.error === "full" };
    };

    const setChoice = (course: string, activity: string | null) => {
      if (activity) labs.set(course, activity);
      else labs.delete(course);
    };

    const choose = async (course: string, activity: string) => {
      const previous = labs.get(course) ?? null;
      setChoice(course, activity);
      open.delete(course);
      render();
      const result = await save(course, activity);
      if (!result.ok) {
        setChoice(course, previous);
        open.add(course);
        render();
        showToast(result.full ? "Sorry, that class just filled up." : "That choice couldn't be saved — try again.", false);
        return;
      }
      lastChange = { course, previous };
      showToast(`Chose ${blockFor(activity)?.dataset.label}.`, true);
    };

    undoButton.addEventListener("click", async () => {
      if (!lastChange) return;
      const { course, previous } = lastChange;
      lastChange = undefined;
      const current = labs.get(course) ?? null;
      setChoice(course, previous);
      render();
      const result = await save(course, previous);
      if (!result.ok) {
        setChoice(course, current);
        render();
        showToast(result.full ? "Couldn't undo — your old class is now full." : "Couldn't undo — try again.", false);
        return;
      }
      showToast(previous ? `Back to ${blockFor(previous)?.dataset.label}.` : `Removed your ${course} choice.`, false);
    });
    document.querySelector("#toast-close")?.addEventListener("click", () => (toast.hidden = true));

    for (const card of cards) {
      card.querySelector(".toggle")?.addEventListener("click", (event) => {
        event.preventDefault();
        const course = card.dataset.course!;
        if (open.has(course)) open.delete(course);
        else open.add(course);
        const perDay = render();
        if (!open.has(course)) return;
        // On a phone only one day shows, so jump to a day that has options.
        if (narrow.matches) {
          if (!perDay[shownDay]) {
            const first = perDay.findIndex((n) => n > 0);
            if (first >= 0) shownDay = first;
            render();
          }
          tabs.scrollIntoView({ behavior: "smooth", block: "start" });
        } else if (stacked.matches) {
          // Cards sit above the week (e.g. a phone in landscape): bring the earliest option into view.
          const earliest = groupBlocks
            .filter((el) => el.dataset.course === course)
            .sort((a, b) => Number(a.dataset.start) - Number(b.dataset.start))[0];
          earliest?.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });
    }

    for (const el of groupBlocks) {
      el.querySelector("form")?.addEventListener("submit", (event) => {
        event.preventDefault();
        const course = el.dataset.course!;
        // Clicking a chosen block while its options are closed reopens them.
        if (!open.has(course)) {
          open.add(course);
          render();
          return;
        }
        choose(course, el.dataset.activity!);
      });
    }

    for (const tab of tabs.querySelectorAll<HTMLElement>("button")) {
      tab.addEventListener("click", () => {
        shownDay = Number(tab.dataset.day);
        render();
      });
    }
    tabs.hidden = false;
    grid.dataset.dayView = "";

    // Live: seat counts from everyone, and this student's choices from other tabs.
    const source = new EventSource("/api/events");
    source.addEventListener("message", (event) => {
      const update = JSON.parse(event.data) as {
        studentId: number;
        change?: { courseCode: string; activityId: string | null };
        seats: Record<string, number>;
      };
      for (const [id, taken] of Object.entries(update.seats)) seats.set(id, taken);
      if (update.studentId === studentId) {
        if (!update.change) {
          location.reload();
          return;
        }
        setChoice(update.change.courseCode, update.change.activityId);
      }
      render();
    });

    render();
  }
</script>
